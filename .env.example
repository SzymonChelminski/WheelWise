# Neon Postgres connection string. Leave empty to run in local mode (in-memory PGlite loaded from data/fixtures).
DATABASE_URL=
# Shared secret; Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the cron route.
CRON_SECRET=
# Public address of the site: canonical links, language alternates and the User-Agent of the refresh job.
# An absolute http: or https: URL without a path, query or hash, e.g. https://example.org (a trailing
# slash is removed); anything else fails the build. Used when set; otherwise https:// plus
# VERCEL_PROJECT_PRODUCTION_URL (set by Vercel); otherwise http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Set to 1 to enable the /design-preview routes.
NEXT_PUBLIC_DESIGN_PREVIEW=
